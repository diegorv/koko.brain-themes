{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/diegorv/koko.brain-themes/main/schema/theme.schema.json",
	"title": "KokoBrain theme package",
	"description": "One theme for KokoBrain, schemaVersion 1. The app derives every color token from `palette`; `overrides` sets tokens the derivation would make different.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"id",
		"name",
		"version",
		"author",
		"palette"
	],
	"properties": {
		"$schema": {
			"type": "string"
		},
		"schemaVersion": {
			"const": 1
		},
		"id": {
			"type": "string",
			"pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
			"maxLength": 64,
			"description": "Stable identifier. Never change it: installed copies are matched by id."
		},
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 64,
			"description": "Display name. May change between versions."
		},
		"version": {
			"type": "string",
			"pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
			"description": "MAJOR.MINOR.PATCH. Bump it on every change, or installed copies never see the update."
		},
		"author": {
			"type": "string",
			"minLength": 1,
			"maxLength": 64
		},
		"palette": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"editorBg",
				"sidebarBg",
				"panelBg",
				"popoverBg",
				"fg",
				"heading",
				"mutedFg",
				"faintFg",
				"border",
				"borderStrong",
				"hover",
				"selected",
				"primary",
				"primaryFg",
				"secondary",
				"selection",
				"highlight",
				"codeFg",
				"codeBg",
				"error",
				"errorFg",
				"blue",
				"green",
				"purple",
				"yellow"
			],
			"properties": {
				"editorBg": {
					"$ref": "#/$defs/color"
				},
				"sidebarBg": {
					"$ref": "#/$defs/color"
				},
				"panelBg": {
					"$ref": "#/$defs/color"
				},
				"popoverBg": {
					"$ref": "#/$defs/color"
				},
				"fg": {
					"$ref": "#/$defs/color"
				},
				"heading": {
					"$ref": "#/$defs/color"
				},
				"mutedFg": {
					"$ref": "#/$defs/color"
				},
				"faintFg": {
					"$ref": "#/$defs/color"
				},
				"border": {
					"$ref": "#/$defs/color"
				},
				"borderStrong": {
					"$ref": "#/$defs/color"
				},
				"hover": {
					"$ref": "#/$defs/color"
				},
				"selected": {
					"$ref": "#/$defs/color"
				},
				"primary": {
					"$ref": "#/$defs/color"
				},
				"primaryFg": {
					"$ref": "#/$defs/color"
				},
				"secondary": {
					"$ref": "#/$defs/color"
				},
				"selection": {
					"$ref": "#/$defs/color"
				},
				"highlight": {
