				},
				"errorFg": {
					"$ref": "#/$defs/color"
				},
				"inlineFg": {
					"$ref": "#/$defs/color"
				},
				"linkFg": {
					"$ref": "#/$defs/color"
				},
				"meta": {
					"$ref": "#/$defs/color"
				},
				"blockquoteAccent": {
					"$ref": "#/$defs/color"
				},
				"blue": {
					"$ref": "#/$defs/color"
				},
				"green": {
					"$ref": "#/$defs/color"
				},
				"purple": {
					"$ref": "#/$defs/color"
				},
				"yellow": {
					"$ref": "#/$defs/color"
				}
			}
		},
