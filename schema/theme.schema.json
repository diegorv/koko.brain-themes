	"$defs": {
		"color": {
			"type": "string",
			"maxLength": 64,
			"description": "A CSS color: hex (3, 4, 6 or 8 digits), rgb()/rgba(), hsl()/hsla(), oklch() with numeric arguments, transparent, or color-mix(in srgb, <color> N%, transparent).",
			"pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|transparent|(rgba?|hsla?|oklch)\\([0-9.%, /+-]*(deg)?[0-9.%, /+-]*\\)|color-mix\\(in srgb, (#[0-9a-fA-F]{3,8}|(rgba?|hsla?|oklch)\\([0-9.%, /+-]*(deg)?[0-9.%, /+-]*\\)) [0-9]{1,3}%, transparent\\))$"
		}
	}
